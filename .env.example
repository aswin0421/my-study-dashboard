# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요. (.env 는 git에 올라가지 않습니다)

# Supabase Keys
SUPABASE_URL=
SUPABASE_KEY=

# Spotify Keys
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:5000/callback

# 서버·Docker 에서만 필요 (내 PC 개발 때는 비워두기)
# 값 확인: python scripts/spotify_refresh_token.py
SPOTIFY_REFRESH_TOKEN=

# Discord 알림 (scripts/notify_today.py 를 내 PC 에서 테스트할 때만 필요)
DISCORD_WEBHOOK_URL=
